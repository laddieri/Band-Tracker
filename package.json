{
  "name": "band-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Tooling for Band Tracker (rules tests + deploy). The app itself is static and needs no build.",
  "scripts": {
    "test:unit": "node --test tests/unit/*.test.js",
    "check:static": "node tests/check-precache.js && node tests/check-handlers.js && node tests/check-render-calls.js",
    "test:rules": "firebase emulators:exec --only firestore \"node --test tests/firestore.test.js\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-band-tracker \"node --test tests/e2e/*.test.js\"",
    "deploy:rules": "firebase deploy --only firestore:rules --project band-tracker-ae9b4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^13.23.0",
    "playwright": "1.56.1"
  }
}
